<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- API 33+ permissions -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"
        android:maxSdkVersion="34" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"
        android:maxSdkVersion="34" />

    <application
        android:name=".SketchApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NewsSocialPlatform"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="34">

        <!-- ========== Auth Activities ========== -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.auth.EmailVerificationActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <!-- ========== Main Activity ========== -->
        <activity
            android:name=".ui.main.MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <!-- ========== Post Activities ========== -->
        <activity
            android:name=".ui.post.CreatePostActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.post.PostDetailsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <!-- ========== Profile Activities ========== -->
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.profile.MyProfileActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.profile.EditProfileActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <!-- ========== Search & Chat Activities ========== -->
        <activity
            android:name=".ui.search.SearchActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.chat.ChatActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <!-- ========== Feed/Content Activities ========== -->
        <activity
            android:name=".ui.feed.SavedPostsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.feed.TrendingActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.feed.FollowingActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.feed.HashtagActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.media.VideosActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.media.PhotosActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <!-- ========== Settings & Notifications ========== -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.notifications.NotificationsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <!-- ========== Admin Activities ========== -->
        <activity
            android:name=".ui.admin.AdminActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.admin.AdminUsersActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.admin.AdminPostsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.admin.AdminReportsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|fontScale|keyboard|keyboardHidden|navigation"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true" />

        <!-- ========== Firebase Cloud Messaging Service ========== -->
        <service
            android:name=".service.FCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>