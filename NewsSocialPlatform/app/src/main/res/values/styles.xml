<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Base Application Theme (Day/Night) -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/text_on_secondary</item>

        <!-- Status & Error colors -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/white</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/nav_background</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Text Styles -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>

        <!-- Window Transitions -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowEnterTransition">@android:transition/fade_in</item>
        <item name="android:windowExitTransition">@android:transition/fade_out</item>

        <!-- Material Components -->
        <item name="materialButtonStyle">@style/Widget.App.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card.Elevated</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
        <item name="tabStyle">@style/Widget.App.TabLayout</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigation</item>
        <item name="chipStyle">@style/Widget.App.Chip</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Splash Screen Theme -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <style name="AppTheme.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <!-- FullScreen Theme (for onboarding, login) -->
    <style name="AppTheme.FullScreen" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Text Appearances -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <style name="TextAppearance.App.Headline1" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.Headline2" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_size_xxl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.Headline3" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_size_xl</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.Subtitle1" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_size_lg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.App.Subtitle2" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/text_size_md</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.Body1" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_size_lg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.App.Body2" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_size_md</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_size_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.App.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_size_xs</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Button Styles -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_md</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">@dimen/corner_radius_md</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:backgroundTint">@color/primary_light</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">@dimen/text_size_md</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">@dimen/corner_radius_md</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.App.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">@dimen/text_size_md</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">@dimen/corner_radius_md</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.App.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/error</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_md</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">@dimen/corner_radius_md</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">@dimen/text_size_md</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">@dimen/corner_radius_md</item>
    </style>

    <style name="Widget.App.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="android:tint">@color/text_secondary</item>
        <item name="iconTint">@color/text_secondary</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Card Styles -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <style name="Widget.App.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_radius_md</item>
        <item name="cardElevation">@dimen/elevation_sm</item>
        <item name="cardBackgroundColor">@color/card</item>
        <item name="contentPadding">@dimen/spacing_md</item>
    </style>

    <style name="Widget.App.Card.Flat" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/corner_radius_md</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="contentPadding">@dimen/spacing_md</item>
    </style>

    <style name="Widget.App.Card.Post" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_radius_md</item>
        <item name="cardElevation">@dimen/elevation_sm</item>
        <item name="cardBackgroundColor">@color/card</item>
        <item name="contentPadding">0dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- TextInputLayout / EditText -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintTextColor">@color/primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_radius_md</item>
    </style>

    <style name="Widget.App.EditText" parent="Widget.Material3.EditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">@dimen/text_size_md</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Toolbar -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface</item>
        <item name="android:elevation">@dimen/elevation_sm</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="android:titleTextAppearance">@style/TextAppearance.App.Headline3</item>
        <item name="android:subtitleTextAppearance">@style/TextAppearance.App.Caption</item>
        <item name="contentInsetStartWithNavigation">0dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Bottom Navigation -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <style name="Widget.App.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/nav_background</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="itemRippleColor">@color/primary_light</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">@dimen/elevation_md</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Tab Layout -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <style name="Widget.App.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">@color/primary</item>
        <item name="tabSelectedTextColor">@color/primary</item>
        <item name="tabTextColor">@color/text_hint</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabMode">scrollable</item>
        <item name="tabBackground">@color/surface</item>
        <item name="tabTextAppearance">@style/TextAppearance.App.Subtitle2</item>
        <item name="tabRippleColor">@color/primary_light</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Chip Style (for hashtags) -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <style name="Widget.App.Chip" parent="Widget.Material3.Chip.Suggestion">
        <item name="chipBackgroundColor">@color/primary_light</item>
        <item name="chipStrokeColor">@android:color/transparent</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">@dimen/corner_radius_round</item>
        <item name="textColor">@color/primary</item>
        <item name="chipIconTint">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">@dimen/text_size_sm</item>
        <item name="chipMinHeight">32dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Dialog Styles -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <style name="AppTheme.Dialog" parent="ThemeOverlay.Material3.Dialog">
        <item name="dialogCornerRadius">@dimen/corner_radius_lg</item>
        <item name="android:background">@color/surface</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <style name="AppTheme.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet</item>
        <item name="android:background">@color/surface</item>
    </style>

    <style name="Widget.App.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.BottomSheet</item>
        <item name="backgroundTint">@color/surface</item>
    </style>

    <style name="ShapeAppearance.App.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/corner_radius_lg</item>
        <item name="cornerSizeTopRight">@dimen/corner_radius_lg</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Shape Appearances -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <style name="ShapeAppearance.App.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_sm</item>
    </style>

    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_md</item>
    </style>

    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_lg</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Avatar Styles -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <style name="ShapeAppearance.App.Avatar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Divider Style -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <style name="Widget.App.Divider" parent="Widget.Material3.MaterialDivider">
        <item name="dividerColor">@color/divider</item>
        <item name="dividerThickness">1dp</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- SwipeRefreshLayout -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <style name="Widget.App.SwipeRefresh" parent="Widget.Material3.SwipeRefreshLayout">
        <item name="progressBackgroundColorSchemeColor">@color/primary_light</item>
        <item name="colorSchemeColors">@color/primary</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- ProgressBar -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <style name="Widget.App.ProgressBar" parent="Widget.Material3.ProgressBar">
        <item name="android:indeterminateTint">@color/primary</item>
    </style>

    <style name="Widget.App.ProgressBar.Linear" parent="Widget.Material3.LinearProgressBar">
        <item name="android:indeterminateTint">@color/primary</item>
        <item name="trackColor">@color/primary_light</item>
    </style>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Shimmer -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <style name="Widget.App.Shimmer" parent="">
        <item name="shimmer_base_color">@color/shimmer_base</item>
        <item name="shimmer_highlight_color">@color/shimmer_highlight</item>
    </style>
</resources>