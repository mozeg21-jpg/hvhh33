<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_background"
    android:direction="rtl"
    android:fitsSystemWindows="true">

    <ScrollView
        android:id="@+id/scrollViewLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Gradient Header -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutHeader"
                android:layout_width="match_parent"
                android:layout_height="@dimen/login_header_height"
                android:background="@drawable/bg_gradient_splash"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Back Arrow -->
                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="@dimen/icon_touch_target"
                    android:layout_height="@dimen/icon_touch_target"
                    android:src="@drawable/ic_arrow_forward"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/back"
                    android:padding="@dimen/spacing_12"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="@dimen/spacing_4"
                    android:layout_marginTop="@dimen/spacing_8" />

                <!-- App Icon -->
                <ImageView
                    android:id="@+id/imageAppIcon"
                    android:layout_width="@dimen/login_icon_size"
                    android:layout_height="@dimen/login_icon_size"
                    android:src="@drawable/ic_app_logo_white"
                    android:contentDescription="@string/app_name"
                    app:layout_constraintBottom_toTopOf="@+id/textLoginTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginBottom="@dimen/spacing_16" />

                <!-- Title -->
                <TextView
                    android:id="@+id/textLoginTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_title"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_header_title"
                    android:textStyle="bold"
                    android:fontFamily="@font/noto_kufi_arabic_bold"
                    app:layout_constraintBottom_toTopOf="@+id/textLoginSubtitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginBottom="@dimen/spacing_4" />

                <!-- Subtitle -->
                <TextView
                    android:id="@+id/textLoginSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_subtitle"
                    android:textColor="@color/white_70"
                    android:textSize="@dimen/text_body"
                    android:fontFamily="@font/noto_kufi_arabic"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginBottom="@dimen/spacing_24" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Login Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLogin"
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/layoutHeader"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="@dimen/spacing_24"
                android:layout_marginEnd="@dimen/spacing_24"
                android:layout_marginTop="@-30dp"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:id="@+id/layoutLoginForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_24"
                    android:paddingEnd="@dimen/spacing_24"
                    android:paddingTop="@dimen/spacing_32"
                    android:paddingBottom="@dimen/spacing_24">

                    <!-- Email Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutEmail"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_email"
                        android:layout_marginBottom="@dimen/spacing_16"
                        app:startIconDrawable="@drawable/ic_alternate_email_outline"
                        app:startIconTint="@color/primary"
                        app:boxCornerRadiusTopStart="@dimen/input_corner_radius"
                        app:boxCornerRadiusTopEnd="@dimen/input_corner_radius"
                        app:boxCornerRadiusBottomStart="@dimen/input_corner_radius"
                        app:boxCornerRadiusBottomEnd="@dimen/input_corner_radius">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textDirection="ltr"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutPassword"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_password"
                        android:layout_marginBottom="@dimen/spacing_8"
                        app:startIconDrawable="@drawable/ic_password_outline"
                        app:startIconTint="@color/primary"
                        app:endIconMode="password_toggle"
                        app:boxCornerRadiusTopStart="@dimen/input_corner_radius"
                        app:boxCornerRadiusTopEnd="@dimen/input_corner_radius"
                        app:boxCornerRadiusBottomStart="@dimen/input_corner_radius"
                        app:boxCornerRadiusBottomEnd="@dimen/input_corner_radius">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Error Text -->
                    <TextView
                        android:id="@+id/textError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/error"
                        android:textSize="@dimen/text_caption"
                        android:fontFamily="@font/noto_kufi_arabic"
                        android:visibility="gone"
                        android:layout_marginBottom="@dimen/spacing_8"
                        android:gravity="start" />

                    <!-- Forgot Password -->
                    <TextView
                        android:id="@+id/textForgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forgot_password"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_body_small"
                        android:fontFamily="@font/noto_kufi_arabic"
                        android:layout_gravity="start"
                        android:padding="@dimen/spacing_4"
                        android:layout_marginBottom="@dimen/spacing_16" />

                    <!-- Login Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:text="@string/login"
                        android:textSize="@dimen/text_button"
                        android:textStyle="bold"
                        android:fontFamily="@font/noto_kufi_arabic_bold"
                        android:layout_marginBottom="@dimen/spacing_12"
                        app:cornerRadius="@dimen/button_corner_radius"
                        app:backgroundTint="@color/primary" />

                    <!-- Go to Register -->
                    <TextView
                        android:id="@+id/textGoRegister"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/go_to_register"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body_small"
                        android:fontFamily="@font/noto_kufi_arabic"
                        android:layout_gravity="center_horizontal"
                        android:padding="@dimen/spacing_8" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Google Sign In Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogleSignIn"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:text="@string/sign_in_with_google"
                android:textSize="@dimen/text_button"
                android:fontFamily="@font/noto_kufi_arabic"
                android:drawableStart="@drawable/ic_google"
                android:drawablePadding="@dimen/spacing_12"
                app:layout_constraintTop_toBottomOf="@+id/cardLogin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="@dimen/spacing_24"
                android:layout_marginEnd="@dimen/spacing_24"
                android:layout_marginTop="@dimen/spacing_16"
                app:cornerRadius="@dimen/button_corner_radius"
                app:strokeColor="@color/divider"
                app:strokeWidth="@dimen/stroke_1" />

            <!-- Guest Mode -->
            <TextView
                android:id="@+id/textGuestMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/guest_mode"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_body_small"
                android:fontFamily="@font/noto_kufi_arabic"
                android:padding="@dimen/spacing_8"
                app:layout_constraintTop_toBottomOf="@+id/btnGoogleSignIn"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/spacing_8" />

            <!-- Bottom spacing -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_32"
                app:layout_constraintTop_toBottomOf="@+id/textGuestMode" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <!-- Shimmer Loading Overlay -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:shimmer_base_alpha="0.3"
        app:shimmer_highlight_alpha="0.6">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_background_shimmer_overlay" />

    </com.facebook.shimmer.ShimmerFrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>