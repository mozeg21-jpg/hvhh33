<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootForgotPassword"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_background"
    android:direction="rtl"
    android:fitsSystemWindows="true">

    <ScrollView
        android:id="@+id/scrollViewForgotPassword"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintForgotPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Gradient Header -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutHeader"
                android:layout_width="match_parent"
                android:layout_height="@dimen/forgot_header_height"
                android:background="@drawable/bg_gradient_splash"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Back Arrow -->
                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="@dimen/icon_touch_target"
                    android:layout_height="@dimen/icon_touch_target"
                    android:src="@drawable/ic_arrow_forward"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/back"
                    android:padding="@dimen/spacing_12"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="@dimen/spacing_4"
                    android:layout_marginTop="@dimen/spacing_8" />

                <!-- Title -->
                <TextView
                    android:id="@+id/textForgotTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forgot_password_title"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_header_title"
                    android:textStyle="bold"
                    android:fontFamily="@font/noto_kufi_arabic_bold"
                    app:layout_constraintBottom_toTopOf="@+id/textForgotSubtitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginBottom="@dimen/spacing_4" />

                <!-- Subtitle -->
                <TextView
                    android:id="@+id/textForgotSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/forgot_password_subtitle"
                    android:textColor="@color/white_70"
                    android:textSize="@dimen/text_body"
                    android:fontFamily="@font/noto_kufi_arabic"
                    android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginStart="@dimen/spacing_32"
                    android:layout_marginEnd="@dimen/spacing_32"
                    android:layout_marginBottom="@dimen/spacing_24" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Email Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardForgotPassword"
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/layoutHeader"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="@dimen/spacing_24"
                android:layout_marginEnd="@dimen/spacing_24"
                android:layout_marginTop="-30dp"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:id="@+id/layoutForgotForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_24"
                    android:paddingEnd="@dimen/spacing_24"
                    android:paddingTop="@dimen/spacing_32"
                    android:paddingBottom="@dimen/spacing_24">

                    <!-- Email Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutEmail"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_email"
                        android:layout_marginBottom="@dimen/spacing_8"
                        app:startIconDrawable="@drawable/ic_alternate_email_outline"
                        app:startIconTint="@color/primary"
                        app:boxCornerRadiusTopStart="@dimen/input_corner_radius"
                        app:boxCornerRadiusTopEnd="@dimen/input_corner_radius"
                        app:boxCornerRadiusBottomStart="@dimen/input_corner_radius"
                        app:boxCornerRadiusBottomEnd="@dimen/input_corner_radius">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textDirection="ltr"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Error Text -->
                    <TextView
                        android:id="@+id/textError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/error"
                        android:textSize="@dimen/text_caption"
                        android:fontFamily="@font/noto_kufi_arabic"
                        android:visibility="gone"
                        android:layout_marginBottom="@dimen/spacing_16"
                        android:gravity="start" />

                    <!-- Send Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSend"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:text="@string/send_recovery_link"
                        android:textSize="@dimen/text_button"
                        android:textStyle="bold"
                        android:fontFamily="@font/noto_kufi_arabic_bold"
                        android:layout_marginBottom="@dimen/spacing_12"
                        app:cornerRadius="@dimen/button_corner_radius"
                        app:backgroundTint="@color/primary" />

                    <!-- Go to Login -->
                    <TextView
                        android:id="@+id/textGoLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/go_to_login"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body_small"
                        android:fontFamily="@font/noto_kufi_arabic"
                        android:layout_gravity="center_horizontal"
                        android:padding="@dimen/spacing_8" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Result Success Card (gone initially) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResult"
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/layoutHeader"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="@dimen/spacing_24"
                android:layout_marginEnd="@dimen/spacing_24"
                android:layout_marginTop="-30dp"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:id="@+id/layoutResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingStart="@dimen/spacing_32"
                    android:paddingEnd="@dimen/spacing_32"
                    android:paddingTop="@dimen/spacing_40"
                    android:paddingBottom="@dimen/spacing_40">

                    <!-- Success Icon -->
                    <ImageView
                        android:id="@+id/imageSuccessIcon"
                        android:layout_width="@dimen/forgot_success_icon_size"
                        android:layout_height="@dimen/forgot_success_icon_size"
                        android:src="@drawable/ic_email_sent"
                        android:contentDescription="@string/email_sent"
                        android:layout_marginBottom="@dimen/spacing_16"
                        app:tint="@color/primary" />

                    <!-- Success Title -->
                    <TextView
                        android:id="@+id/textResultTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/email_sent_success_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold"
                        android:fontFamily="@font/noto_kufi_arabic_bold"
                        android:layout_marginBottom="@dimen/spacing_8"
                        android:gravity="center" />

                    <!-- Success Message -->
                    <TextView
                        android:id="@+id/textResultMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/email_sent_success_message"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body"
                        android:fontFamily="@font/noto_kufi_arabic"
                        android:gravity="center"
                        android:lineSpacingExtra="@dimen/spacing_4" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom spacing -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_48"
                app:layout_constraintTop_toBottomOf="@+id/cardForgotPassword" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>