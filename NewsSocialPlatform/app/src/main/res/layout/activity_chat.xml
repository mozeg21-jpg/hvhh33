<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootChat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:direction="rtl"
    android:fitsSystemWindows="true">

    <!-- AppBarLayout with Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            app:elevation="@dimen/elevation_xs"
            android:layoutDirection="rtl">

            <!-- Back Arrow -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:padding="12dp"
                android:layout_gravity="end"
                android:layout_marginEnd="4dp" />

            <!-- Avatar + Name + Online Status -->
            <LinearLayout
                android:id="@+id/layoutChatUser"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:background="?attr/selectableItemBackground">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/imgAvatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_default_avatar"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/avatar"
                    app:civ_border_color="@color/divider"
                    app:civ_border_width="1dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:id="@+id/textUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="اسم المستخدم"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/noto_kufi_arabic_bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/textOnlineStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="متصل الآن"
                        android:textColor="@color/online_green"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Video Call -->
            <ImageButton
                android:id="@+id/btnVideoCall"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:src="@drawable/ic_video_call"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/video_call"
                android:padding="12dp"
                android:layout_gravity="start"
                app:tint="@color/primary" />

            <!-- Voice Call -->
            <ImageButton
                android:id="@+id/btnVoiceCall"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:src="@drawable/ic_call"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/voice_call"
                android:padding="12dp"
                android:layout_gravity="start"
                app:tint="@color/primary" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMessages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:stackFromEnd="true"
        app:reverseLayout="true" />

    <!-- Reply Preview Bar -->
    <LinearLayout
        android:id="@+id/replyPreviewBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:background="@color/surface"
        android:elevation="@dimen/elevation_md"
        android:visibility="gone">

        <!-- Reply Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <!-- Vertical bar indicator -->
            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@color/primary"
                android:layout_marginStart="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/textReplyUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="اسم المستخدم"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/textReplyContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="نص الرسالة المُردَّ عليها"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Close Reply -->
            <ImageButton
                android:id="@+id/btnCloseReply"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_close"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:padding="6dp"
                app:tint="@color/text_hint" />

        </LinearLayout>

        <!-- Divider -->
        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:dividerColor="@color/divider" />

    </LinearLayout>

    <!-- Bottom Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="bottom"
        android:background="@color/surface"
        android:paddingVertical="8dp"
        android:paddingHorizontal="8dp"
        android:gravity="center_vertical"
        android:elevation="@dimen/elevation_md">

        <!-- Attach Button -->
        <ImageButton
            android:id="@+id/btnAttach"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_attachment"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/attach"
            android:padding="8dp"
            app:tint="@color/primary" />

        <!-- Message Input -->
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:minHeight="40dp"
            android:maxHeight="120dp"
            android:background="@drawable/bg_message_input"
            android:hint="اكتب رسالة..."
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="@font/noto_kufi_arabic"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:gravity="center_vertical|start" />

        <!-- Record Button (hold to record) -->
        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_microphone"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/record"
            android:padding="8dp"
            app:tint="@color/primary" />

        <!-- Send Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:visibility="gone"
            app:cornerRadius="@dimen/corner_radius_round"
            app:backgroundTint="@color/primary"
            app:icon="@drawable/ic_send"
            app:iconTint="@color/white"
            app:iconSize="18dp"
            app:iconPadding="0dp" />

        <!-- Emoji Button -->
        <ImageButton
            android:id="@+id/btnEmoji"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_emoji"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/emoji"
            android:padding="8dp"
            app:tint="@color/text_hint" />

    </LinearLayout>

    <!-- Bottom Sheet for Attachments -->
    <com.google.android.material.bottomsheet.BottomSheetDialog
        android:id="@+id/bottomSheetAttachments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    </com.google.android.material.bottomsheet.BottomSheetDialog>

    <!-- Attachment Bottom Sheet Content (separate layout) -->
    <FrameLayout
        android:id="@+id/standardBottomSheet"
        style="@style/Widget.Material3.BottomSheet.ModalContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="16dp"
            android:paddingHorizontal="24dp">

            <!-- Drag Handle -->
            <com.google.android.material.bottomsheet.BottomSheetDragHandleView
                android:id="@+id/dragHandle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إرفاق ملف"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/noto_kufi_arabic_bold"
                android:layout_marginBottom="16dp" />

            <!-- Attachments Grid (3 columns) -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="2"
                android:useDefaultMargins="true">

                <!-- Image -->
                <LinearLayout
                    android:id="@+id/btnAttachImage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="16dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_image"
                        android:contentDescription="@string/image"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="صورة"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:fontFamily="@font/noto_kufi_arabic"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- Video -->
                <LinearLayout
                    android:id="@+id/btnAttachVideo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="16dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_video"
                        android:contentDescription="@string/video"
                        app:tint="@color/secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="فيديو"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:fontFamily="@font/noto_kufi_arabic"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- File -->
                <LinearLayout
                    android:id="@+id/btnAttachFile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="16dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_file"
                        android:contentDescription="@string/file"
                        app:tint="@color/success" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ملف"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:fontFamily="@font/noto_kufi_arabic"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- Location -->
                <LinearLayout
                    android:id="@+id/btnAttachLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="16dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_location"
                        android:contentDescription="@string/location"
                        app:tint="@color/error" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="موقع"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:fontFamily="@font/noto_kufi_arabic"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- Contact -->
                <LinearLayout
                    android:id="@+id/btnAttachContact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="16dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_contact"
                        android:contentDescription="@string/contact"
                        app:tint="@color/info" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="جهة اتصال"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:fontFamily="@font/noto_kufi_arabic"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- GIF -->
                <LinearLayout
                    android:id="@+id/btnAttachGif"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="16dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_gif"
                        android:contentDescription="@string/gif"
                        app:tint="@color/warning" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GIF"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:fontFamily="@font/noto_kufi_arabic"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </GridLayout>

        </LinearLayout>

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>