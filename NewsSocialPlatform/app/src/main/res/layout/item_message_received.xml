<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="48dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp">

    <!-- Sender Name (for groups) -->
    <TextView
        android:id="@+id/senderName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/md_theme_light_primary"
        android:visibility="gone"
        android:layout_marginBottom="2dp" />

    <!-- Reply Preview -->
    <LinearLayout
        android:id="@+id/replyPreview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_below="@id/senderName"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/bg_reply_preview_received"
        android:visibility="gone"
        android:layout_marginBottom="4dp"
        android:layoutDirection="rtl">

        <TextView
            android:id="@+id/textReplySender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/md_theme_light_primary" />

        <TextView
            android:id="@+id/textReplyContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/md_theme_light_onSurfaceVariant"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Message Bubble -->
    <LinearLayout
        android:id="@+id/messageBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_below="@id/replyPreview"
        android:background="@drawable/bg_message_received"
        android:padding="10dp"
        android:orientation="vertical">

        <!-- Image Message -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imageMessage"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/roundedImageViewMessage"
            android:contentDescription="message_image" />

        <!-- Video Thumbnail -->
        <FrameLayout
            android:id="@+id/videoThumbnailContainer"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/videoThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="video_thumbnail" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_circle"
                android:contentDescription="play" />

        </FrameLayout>

        <!-- Text Message -->
        <TextView
            android:id="@+id/textMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/md_theme_light_onSurface"
            android:layoutDirection="rtl"
            android:textDirection="locale" />

        <!-- Time -->
        <TextView
            android:id="@+id/textTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_gravity="end"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</RelativeLayout>