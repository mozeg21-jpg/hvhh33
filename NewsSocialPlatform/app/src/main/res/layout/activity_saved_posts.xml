<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSavedPosts"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:direction="rtl"
    android:fitsSystemWindows="true">

    <!-- AppBarLayout with Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            app:elevation="@dimen/elevation_xs"
            android:layoutDirection="rtl">

            <!-- Back Arrow -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:padding="12dp"
                android:layout_gravity="end"
                android:layout_marginEnd="4dp" />

            <!-- Title -->
            <TextView
                android:id="@+id/textToolbarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="المحفوظات"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/noto_kufi_arabic_bold"
                android:layout_gravity="center" />

            <!-- New List Button -->
            <ImageButton
                android:id="@+id/btnNewList"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:src="@drawable/ic_add"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/new_list"
                android:padding="12dp"
                android:layout_gravity="start"
                android:layout_marginStart="4dp"
                app:tint="@color/primary" />

        </com.google.android.material.appbar.MaterialToolbar>

        <!-- TabLayout (first tab: الكل, plus dynamic list tabs) -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            app:tabMode="scrollable"
            app:tabIndicatorColor="@color/primary"
            app:tabSelectedTextColor="@color/primary"
            app:tabTextColor="@color/text_hint"
            app:tabTextAppearance="@style/TextAppearance.Material3.TitleSmall"
            app:tabRippleColor="@color/primary_light">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الكل" />

            <!-- Dynamic tabs added programmatically from SavedPost.listName -->

        </com.google.android.material.tabs.TabLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ViewPager2 with RecyclerView -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Bookmark Icon -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:cardCornerRadius="@dimen/corner_radius_round"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/primary_light">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bookmark_outline"
                android:contentDescription="@string/save"
                app:tint="@color/primary" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="لا توجد منشورات محفوظة"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/noto_kufi_arabic_bold"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="يمكنك حفظ المنشورات للرجوع إليها لاحقاً"
            android:textColor="@color/text_hint"
            android:textSize="13sp"
            android:fontFamily="@font/noto_kufi_arabic"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="40dp"
            android:gravity="center" />

        <!-- Browse Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBrowsePosts"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="تصفح المنشورات"
            android:textSize="14sp"
            android:fontFamily="@font/noto_kufi_arabic_bold"
            android:paddingHorizontal="24dp"
            android:layout_marginTop="20dp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="@dimen/corner_radius_round"
            android:textColor="@color/white" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>