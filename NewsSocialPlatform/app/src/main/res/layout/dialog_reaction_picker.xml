<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical">

    <!-- Like -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_margin="4dp">

        <ImageButton
            android:id="@+id/btnReactionLike"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_reaction_like"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="like" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👍"
            android:textSize="10sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Love -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_margin="4dp">

        <ImageButton
            android:id="@+id/btnReactionLove"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_reaction_love"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="love" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❤️"
            android:textSize="10sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Haha -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_margin="4dp">

        <ImageButton
            android:id="@+id/btnReactionHaha"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_reaction_haha"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="haha" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="😂"
            android:textSize="10sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Wow -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_margin="4dp">

        <ImageButton
            android:id="@+id/btnReactionWow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_reaction_wow"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="wow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="😮"
            android:textSize="10sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Sad -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_margin="4dp">

        <ImageButton
            android:id="@+id/btnReactionSad"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_reaction_sad"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="sad" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="😢"
            android:textSize="10sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Angry -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_margin="4dp">

        <ImageButton
            android:id="@+id/btnReactionAngry"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_reaction_angry"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="angry" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="😡"
            android:textSize="10sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>