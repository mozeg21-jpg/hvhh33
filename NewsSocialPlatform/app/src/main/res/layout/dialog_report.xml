<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:layoutDirection="rtl">

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/report_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_light_onSurface"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- Report Reasons -->
            <RadioGroup
                android:id="@+id/radioGroupReasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbInappropriate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/report_inappropriate"
                    android:textSize="14sp"
                    android:layoutDirection="rtl"
                    android:paddingVertical="4dp" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbScam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/report_scam"
                    android:textSize="14sp"
                    android:layoutDirection="rtl"
                    android:paddingVertical="4dp" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbViolence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/report_violence"
                    android:textSize="14sp"
                    android:layoutDirection="rtl"
                    android:paddingVertical="4dp" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbHarassment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/report_harassment"
                    android:textSize="14sp"
                    android:layoutDirection="rtl"
                    android:paddingVertical="4dp" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbRightsViolation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/report_rights_violation"
                    android:textSize="14sp"
                    android:layoutDirection="rtl"
                    android:paddingVertical="4dp" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbOffensive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/report_offensive"
                    android:textSize="14sp"
                    android:layoutDirection="rtl"
                    android:paddingVertical="4dp" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbAbuse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/report_abuse"
                    android:textSize="14sp"
                    android:layoutDirection="rtl"
                    android:paddingVertical="4dp" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rbOther"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/report_other"
                    android:textSize="14sp"
                    android:layoutDirection="rtl"
                    android:paddingVertical="4dp" />

            </RadioGroup>

            <!-- Description (optional) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/report_description_hint"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:inputType="textMultiLine"
                    android:maxLines="4"
                    android:textSize="14sp"
                    android:layoutDirection="rtl"
                    android:gravity="top|start" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/submit_report"
                android:textSize="15sp"
                android:layout_marginTop="20dp"
                app:cornerRadius="16dp" />

        </LinearLayout>

    </ScrollView>

</com.google.android.material.card.MaterialCardView>