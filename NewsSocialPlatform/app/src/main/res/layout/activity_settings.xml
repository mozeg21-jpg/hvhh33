<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:direction="rtl"
    android:fitsSystemWindows="true">

    <!-- AppBarLayout with Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            app:elevation="@dimen/elevation_xs"
            android:layoutDirection="rtl">

            <!-- Back Arrow -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:padding="12dp"
                android:layout_gravity="end"
                android:layout_marginEnd="4dp" />

            <!-- Title -->
            <TextView
                android:id="@+id/textToolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الإعدادات"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/noto_kufi_arabic_bold"
                android:layout_gravity="center" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layoutDirection="rtl"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ═══════════════════════════════════════ -->
            <!-- Section: المظهر (Appearance) -->
            <!-- ═══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="@dimen/elevation_xs"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Section Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="المظهر"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/noto_kufi_arabic_bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Theme Selection -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="السمة"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/noto_kufi_arabic"
                        android:layout_marginBottom="8dp" />

                    <RadioGroup
                        android:id="@+id/radioGroupTheme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioThemeLight"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="فاتح"
                            android:textSize="13sp"
                            android:fontFamily="@font/noto_kufi_arabic" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioThemeDark"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="داكن"
                            android:textSize="13sp"
                            android:fontFamily="@font/noto_kufi_arabic" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/radioThemeAuto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="تلقائي"
                            android:textSize="13sp"
                            android:fontFamily="@font/noto_kufi_arabic" />

                    </RadioGroup>

                    <!-- Font Size -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="حجم الخط"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/noto_kufi_arabic"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ص"
                            android:textColor="@color/text_hint"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/seekBarFontSize"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="24"
                            android:min="12"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:progressTint="@color/primary"
                            android:thumbTint="@color/primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ك"
                            android:textColor="@color/text_hint"
                            android:textSize="24sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════ -->
            <!-- Section: اللغة (Language) -->
            <!-- ═══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="@dimen/elevation_xs"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="اللغة"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/noto_kufi_arabic_bold"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutLanguage"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <AutoCompleteTextView
                            android:id="@+id/dropdownLanguage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="اختر اللغة"
                            android:textSize="14sp"
                            android:inputType="none" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════ -->
            <!-- Section: الخصوصية (Privacy) -->
            <!-- ═══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="@dimen/elevation_xs"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الخصوصية"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/noto_kufi_arabic_bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Private Account -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchPrivateAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="حساب خاص"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/noto_kufi_arabic"
                        android:layout_marginBottom="8dp"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/divider" />

                    <!-- Online Status Visible -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchOnlineVisible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="إظهار حالة الاتصال"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/noto_kufi_arabic"
                        android:layout_marginBottom="8dp"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/divider" />

                    <!-- Read Receipts -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchReadReceipts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="إيصال القراءة"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/noto_kufi_arabic"
                        android:layout_marginBottom="8dp"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/divider" />

                    <!-- Typing Indicator -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchTypingIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="مؤشر الكتابة"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/noto_kufi_arabic"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/divider" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════ -->
            <!-- Section: الإشعارات (Notifications) -->
            <!-- ═══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="@dimen/elevation_xs"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الإشعارات"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/noto_kufi_arabic_bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Likes Notifications -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchNotifLikes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="الإعجابات"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/noto_kufi_arabic"
                        android:layout_marginBottom="8dp"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/divider" />

                    <!-- Comments Notifications -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchNotifComments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="التعليقات"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/noto_kufi_arabic"
                        android:layout_marginBottom="8dp"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/divider" />

                    <!-- Follows Notifications -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchNotifFollows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="المتابعات الجديدة"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/noto_kufi_arabic"
                        android:layout_marginBottom="8dp"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/divider" />

                    <!-- Messages Notifications -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchNotifMessages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="الرسائل"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/noto_kufi_arabic"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/divider" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════ -->
            <!-- Section: الحساب (Account) -->
            <!-- ═══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="@dimen/elevation_xs"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="الحساب"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/noto_kufi_arabic_bold"
                        android:padding="16dp"
                        android:paddingBottom="8dp" />

                    <!-- Change Password -->
                    <LinearLayout
                        android:id="@+id/btnChangePassword"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch_target_min"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="تغيير كلمة المرور"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/noto_kufi_arabic" />

                        <ImageView
                            android:layout_width="@dimen/icon_size_md"
                            android:layout_height="@dimen/icon_size_md"
                            android:src="@drawable/ic_arrow_back"
                            android:rotation="180"
                            app:tint="@color/text_hint"
                            android:contentDescription="@string/navigate" />

                    </LinearLayout>

                    <!-- Change Email -->
                    <LinearLayout
                        android:id="@+id/btnChangeEmail"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch_target_min"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="تغيير البريد الإلكتروني"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/noto_kufi_arabic" />

                        <ImageView
                            android:layout_width="@dimen/icon_size_md"
                            android:layout_height="@dimen/icon_size_md"
                            android:src="@drawable/ic_arrow_back"
                            android:rotation="180"
                            app:tint="@color/text_hint"
                            android:contentDescription="@string/navigate" />

                    </LinearLayout>

                    <!-- Download Data -->
                    <LinearLayout
                        android:id="@+id/btnDownloadData"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch_target_min"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="تحميل بياناتي"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/noto_kufi_arabic" />

                        <ImageView
                            android:layout_width="@dimen/icon_size_md"
                            android:layout_height="@dimen/icon_size_md"
                            android:src="@drawable/ic_download"
                            app:tint="@color/text_hint"
                            android:contentDescription="@string/download" />

                    </LinearLayout>

                    <!-- Deactivate Account -->
                    <LinearLayout
                        android:id="@+id/btnDeactivate"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch_target_min"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="تعطيل الحساب"
                            android:textColor="@color/warning"
                            android:textSize="14sp"
                            android:fontFamily="@font/noto_kufi_arabic" />

                        <ImageView
                            android:layout_width="@dimen/icon_size_md"
                            android:layout_height="@dimen/icon_size_md"
                            android:src="@drawable/ic_pause_circle"
                            app:tint="@color/warning"
                            android:contentDescription="@string/deactivate" />

                    </LinearLayout>

                    <!-- Delete Account (Red) -->
                    <LinearLayout
                        android:id="@+id/btnDeleteAccount"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch_target_min"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="حذف الحساب"
                            android:textColor="@color/error"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/noto_kufi_arabic_bold" />

                        <ImageView
                            android:layout_width="@dimen/icon_size_md"
                            android:layout_height="@dimen/icon_size_md"
                            android:src="@drawable/ic_delete"
                            app:tint="@color/error"
                            android:contentDescription="@string/delete_account" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════ -->
            <!-- Section: البيانات (Data) -->
            <!-- ═══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="@dimen/elevation_xs"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="البيانات"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/noto_kufi_arabic_bold"
                        android:padding="16dp"
                        android:paddingBottom="8dp" />

                    <!-- Backup -->
                    <LinearLayout
                        android:id="@+id/btnBackup"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch_target_min"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="نسخ احتياطي"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/noto_kufi_arabic" />

                        <ImageView
                            android:layout_width="@dimen/icon_size_md"
                            android:layout_height="@dimen/icon_size_md"
                            android:src="@drawable/ic_backup"
                            app:tint="@color/text_hint"
                            android:contentDescription="@string/backup" />

                    </LinearLayout>

                    <!-- Restore -->
                    <LinearLayout
                        android:id="@+id/btnRestore"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch_target_min"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="استعادة"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/noto_kufi_arabic" />

                        <ImageView
                            android:layout_width="@dimen/icon_size_md"
                            android:layout_height="@dimen/icon_size_md"
                            android:src="@drawable/ic_restore"
                            app:tint="@color/text_hint"
                            android:contentDescription="@string/restore" />

                    </LinearLayout>

                    <!-- Clear Cache (with size) -->
                    <LinearLayout
                        android:id="@+id/btnClearCache"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch_target_min"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="مسح ذاكرة التخزين المؤقت"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/noto_kufi_arabic" />

                        <TextView
                            android:id="@+id/textCacheSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 MB"
                            android:textColor="@color/text_hint"
                            android:textSize="12sp"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════ -->
            <!-- Section: حول التطبيق (About) -->
            <!-- ═══════════════════════════════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="@dimen/corner_radius_md"
                app:cardElevation="@dimen/elevation_xs"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="حول التطبيق"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/noto_kufi_arabic_bold"
                        android:padding="16dp"
                        android:paddingBottom="8dp" />

                    <!-- Version -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch_target_min"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="الإصدار"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/noto_kufi_arabic" />

                        <TextView
                            android:id="@+id/textVersion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.0.0"
                            android:textColor="@color/text_hint"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <!-- Rate App -->
                    <LinearLayout
                        android:id="@+id/btnRateApp"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch_target_min"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="تقييم التطبيق"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/noto_kufi_arabic" />

                        <ImageView
                            android:layout_width="@dimen/icon_size_md"
                            android:layout_height="@dimen/icon_size_md"
                            android:src="@drawable/ic_star"
                            app:tint="@color/warning"
                            android:contentDescription="@string/rate" />

                    </LinearLayout>

                    <!-- Privacy Policy -->
                    <LinearLayout
                        android:id="@+id/btnPrivacyPolicy"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch_target_min"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="سياسة الخصوصية"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/noto_kufi_arabic" />

                        <ImageView
                            android:layout_width="@dimen/icon_size_md"
                            android:layout_height="@dimen/icon_size_md"
                            android:src="@drawable/ic_arrow_back"
                            android:rotation="180"
                            app:tint="@color/text_hint"
                            android:contentDescription="@string/navigate" />

                    </LinearLayout>

                    <!-- Terms of Service -->
                    <LinearLayout
                        android:id="@+id/btnTerms"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch_target_min"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|end"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="شروط الاستخدام"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:fontFamily="@font/noto_kufi_arabic" />

                        <ImageView
                            android:layout_width="@dimen/icon_size_md"
                            android:layout_height="@dimen/icon_size_md"
                            android:src="@drawable/ic_arrow_back"
                            android:rotation="180"
                            app:tint="@color/text_hint"
                            android:contentDescription="@string/navigate" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════════════════════════════ -->
            <!-- Logout Button (Red Outline, Full Width) -->
            <!-- ═══════════════════════════════════════ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="16dp"
                android:text="تسجيل الخروج"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/error"
                android:fontFamily="@font/noto_kufi_arabic_bold"
                app:strokeColor="@color/error"
                app:strokeWidth="1dp"
                app:cornerRadius="@dimen/corner_radius_md"
                app:icon="@drawable/ic_logout"
                app:iconTint="@color/error"
                app:iconSize="20dp"
                app:iconGravity="textEnd" />

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
