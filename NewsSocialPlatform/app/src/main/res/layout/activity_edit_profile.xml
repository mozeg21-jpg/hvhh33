<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootEditProfile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:direction="rtl"
    android:fitsSystemWindows="true">

    <!-- AppBarLayout with Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            app:elevation="@dimen/elevation_xs"
            android:layoutDirection="rtl">

            <!-- Back Arrow -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:padding="12dp"
                android:layout_gravity="end"
                android:layout_marginEnd="4dp" />

            <!-- Title -->
            <TextView
                android:id="@+id/textToolbarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="تعديل الملف الشخصي"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/noto_kufi_arabic_bold"
                android:layout_gravity="center" />

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="حفظ"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/noto_kufi_arabic_bold"
                android:minWidth="72dp"
                android:paddingHorizontal="20dp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="@dimen/corner_radius_round"
                android:textColor="@color/white" />

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layoutDirection="rtl"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="@dimen/corner_radius_lg"
            app:cardElevation="@dimen/elevation_xs"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Avatar Section -->
                <FrameLayout
                    android:id="@+id/avatarContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="20dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:src="@drawable/ic_default_avatar"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/avatar"
                        app:civ_border_color="@color/divider"
                        app:civ_border_width="2dp" />

                    <!-- Camera Overlay Button -->
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btnChangeAvatar"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="-4dp"
                        android:layout_marginBottom="-4dp"
                        android:src="@drawable/ic_camera"
                        android:contentDescription="@string/change_avatar"
                        app:fabCustomSize="36dp"
                        app:maxImageSize="18dp"
                        app:backgroundTint="@color/primary"
                        app:tint="@color/white"
                        app:borderWidth="0dp"
                        app:elevation="@dimen/elevation_sm" />

                </FrameLayout>

                <!-- Cover Photo Section -->
                <FrameLayout
                    android:id="@+id/coverContainer"
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_marginBottom="20dp">

                    <ImageView
                        android:id="@+id/imgCoverPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_default_cover"
                        android:contentDescription="@string/cover_photo"
                        android:background="@color/card_border" />

                    <!-- Camera Overlay Button -->
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btnChangeCover"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="12dp"
                        android:src="@drawable/ic_camera"
                        android:contentDescription="@string/change_cover"
                        app:fabCustomSize="36dp"
                        app:maxImageSize="18dp"
                        app:backgroundTint="@color/primary"
                        app:tint="@color/white"
                        app:borderWidth="0dp"
                        app:elevation="@dimen/elevation_sm" />

                </FrameLayout>

                <!-- Divider -->
                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="20dp"
                    app:dividerColor="@color/divider" />

                <!-- Name -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutName"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="الاسم الكامل">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:inputType="textPersonName"
                        android:fontFamily="@font/noto_kufi_arabic" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Username -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutUsername"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@اسم المستخدم"
                    app:startIconDrawable="@drawable/ic_at"
                    app:startIconTint="@color/text_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:inputType="text" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Bio (Multiline) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutBio"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="النبذة الشخصية"
                    app:counterEnabled="true"
                    app:counterMaxLength="200">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editBio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="80dp"
                        android:gravity="top|start"
                        android:textSize="14sp"
                        android:inputType="textMultiLine|textCapSentences"
                        android:fontFamily="@font/noto_kufi_arabic" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Country -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutCountry"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="الدولة"
                    app:startIconDrawable="@drawable/ic_flag"
                    app:startIconTint="@color/text_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editCountry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:inputType="text" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- City -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutCity"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="المدينة"
                    app:startIconDrawable="@drawable/ic_location"
                    app:startIconTint="@color/text_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editCity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:inputType="text" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Birth Date -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutBirthDate"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="تاريخ الميلاد"
                    app:startIconDrawable="@drawable/ic_calendar"
                    app:startIconTint="@color/text_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editBirthDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:inputType="none"
                        android:focusable="false"
                        android:cursorVisible="false" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Gender Dropdown -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutGender"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="الجنس">

                    <AutoCompleteTextView
                        android:id="@+id/dropdownGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Website -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutWebsite"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="الموقع الإلكتروني"
                    app:startIconDrawable="@drawable/ic_link"
                    app:startIconTint="@color/text_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editWebsite"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:inputType="textUri" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Social Links Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="روابط التواصل الاجتماعي"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/noto_kufi_arabic_bold"
                    android:layout_marginBottom="12dp" />

                <!-- Social Links RecyclerView (dynamic add/remove) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerSocialLinks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <!-- Add Social Link Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddSocialLink"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ إضافة رابط"
                    android:textColor="@color/primary"
                    app:icon="@drawable/ic_add"
                    app:iconTint="@color/primary"
                    app:iconGravity="textEnd"
                    android:layout_marginBottom="16dp" />

                <!-- Divider -->
                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="16dp"
                    app:dividerColor="@color/divider" />

                <!-- Private Profile Switch -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchPrivateProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="حساب خاص"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/noto_kufi_arabic"
                    android:layout_marginBottom="12dp"
                    app:thumbTint="@color/white"
                    app:trackTint="@color/divider" />

                <!-- Online Visible Switch -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchOnlineVisible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="إظهار حالة الاتصال"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/noto_kufi_arabic"
                    android:layout_marginBottom="16dp"
                    app:thumbTint="@color/white"
                    app:trackTint="@color/divider" />

                <!-- Error Text -->
                <TextView
                    android:id="@+id/textError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/error"
                    android:textSize="13sp"
                    android:fontFamily="@font/noto_kufi_arabic"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
