<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chatRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layoutDirection="rtl"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imgUserAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@color/md_theme_light_surfaceVariant"
            android:contentDescription="@string/profile_picture" />

        <View
            android:id="@+id/onlineDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_online_dot"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <!-- Name + Time Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_light_onSurface"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/textTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary" />

        </LinearLayout>

        <!-- Last Message -->
        <TextView
            android:id="@+id/textLastMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorSecondary"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:layoutDirection="rtl" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginStart="4dp">

        <TextView
            android:id="@+id/textUnreadCount"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/bg_unread_badge"
            android:gravity="center"
            android:textSize="10sp"
            android:textColor="@android:color/white"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textUnreadBadge"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/bg_unread_badge"
            android:gravity="center"
            android:textSize="10sp"
            android:textColor="@android:color/white"
            android:visibility="gone"
            android:layout_marginTop="4dp" />

        <ImageView
            android:id="@+id/muteIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_notifications_off"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:contentDescription="muted" />

    </LinearLayout>

</LinearLayout>